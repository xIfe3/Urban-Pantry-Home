# Copy this file to .env for local development, or set these as real
# environment variables in cPanel's "Setup Python App" screen for production.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=urbanpantry.com,www.urbanpantry.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://urbanpantry.com,https://www.urbanpantry.com

# --- Database (MySQL on cPanel) ---
# Leave DB_ENGINE unset to keep using local sqlite.
DB_ENGINE=mysql
DB_NAME=cpanelusername_urbanpantry
DB_USER=cpanelusername_dbuser
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# --- Static / media (only needed if you want non-default locations) ---
# DJANGO_STATIC_ROOT=/home/cpanelusername/urbanpantry/staticfiles
# DJANGO_MEDIA_ROOT=/home/cpanelusername/urbanpantry/media

# --- HTTPS / security (only apply when DJANGO_DEBUG=False) ---
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Turn on only once HTTPS is confirmed working end to end, to avoid redirect loops.
DJANGO_SECURE_SSL_REDIRECT=False

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Urban Pantry <no-reply@urbanpantry.com>
EMAIL_HOST=mail.urbanpantry.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@urbanpantry.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True

# --- Media storage (Railway Bucket / any S3-compatible) ---
# Leave BUCKET_NAME unset to store uploads on the local filesystem.
BUCKET_NAME=
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
